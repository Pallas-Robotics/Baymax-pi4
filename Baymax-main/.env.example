OPENAI_API_KEY=your_openai_api_key_here

# Desktop Gemini development (configure through devUI)
GOOGLE_API_KEY=
BAYMAX_MIC_DEVICE=
BAYMAX_SPEAKER_DEVICE=
BAYMAX_CAMERA_DEVICE=
# Email credentials intentionally omitted for development.

# Location/weather Gemini tools (0 disables lookups and preloading)
BAYMAX_TOOLKIT_ENABLED=1

# Google Search (the search_web tool): Gemini writes a search query and a short lookup
# session with Google Search answers it; only the query is sent. On by default; 0 turns
# it off. Ember's conversation keeps no thinking either way (the fastest replies).
# BAYMAX_GOOGLE_SEARCH=0
# The Live model that answers searches; it must reply in text.
# BAYMAX_SEARCH_MODEL=gemini-robotics-er-2-streaming-preview

# Experimental fall detection (CPU, or NPU on a set-up Orange Pi); enable in Setup and restart Ember.
# In v10 it reuses the core's pose; with the built-in detection on (device.toml) it shows its
# results in the Monitor and leaves the check-in to the built-in one: one check-in per fall.
BAYMAX_FALL_DETECTION_ENABLED=0
# BAYMAX_FALL_FPS=10

# Keep Ember and its pose process on the fast cores of an ARM big.LITTLE board (the face
# process of eye-contact greetings goes to the slow cores): auto (default) only on an RK3588
# (Orange Pi 5 / 5 Max, where it was measured); on for any such board (e.g. to try the
# Orange Pi 4 Pro's two A76s, unmeasured); off never. See ORANGE_PI_SETUP.md, Fast cores.
# BAYMAX_CPU_PINNING=auto
# Only while pinned: Python's GIL switch interval in ms (default 1; 5 is Python's own, 0
# leaves it alone; 0.1-100). The mic callback waits up to one interval to get the GIL back.
# BAYMAX_GIL_SWITCH_MS=1
# Only while pinned: auto (default) keeps the pose process on the fast cores at nice 5 and
# puts the face process on the slow cores at nice 10; fast or slow puts both there, to measure.
# BAYMAX_VISION_CPUS=auto
# Camera pose backend (features/pose): auto uses a set-up Orange Pi 5 NPU, cpu forces MediaPipe.
# BAYMAX_POSE_BACKEND=auto

# MVP eyes default on for Linux, off on other platforms. No servo.
# BAYMAX_EYES_ENABLED=0
# BAYMAX_EYES_PORT=/dev/serial/by-id/usb-Unknown_LattePanda_Leonardo-if00

# MVP local "hmm" after waits over 2s; requires working echo cancellation.
# BAYMAX_WAIT_CUE_ENABLED=0

# Lower speech-start sensitivity reduces false interruptions (default: low).
# BAYMAX_SPEECH_START_SENSITIVITY=low
# Speech-end sensitivity: low (default) waits through short pauses; high ends turns sooner (faster replies, more cut-offs).
# BAYMAX_SPEECH_END_SENSITIVITY=low
# Recalled memories handed to Gemini between turns (opt-in). Gemini 2.5 ignored such
# notes in live tests; the newest 50 memories are in its instructions either way.
# BAYMAX_MEMORY_NOTES=1

# MVP prevents speech-triggered interruptions by default so speaker echo cannot
# cut Ember off. Set 1 only after live echo-cancellation testing confirms barge-in.
# BAYMAX_INTERRUPTION_ENABLED=0
# Wait for a natural pause before replying (MVP default 400 ms; valid 300-2000).
# BAYMAX_TURN_END_SILENCE_MS=400

# Let the existing Gemini session judge conversational intent. Set 1 to opt into
# the strict local name/20-second gate (can suppress legitimate direct questions).
# BAYMAX_ADDRESS_GATE=0

# Send silence to Gemini while Ember's speaker (plus a 250ms echo tail) is audible,
# so leaked robot speech never becomes a user turn. Defaults on when interruptions are off.
# BAYMAX_MUTE_MIC_DURING_REPLY=1

# High-pass cutoff (Hz) applied before echo cancellation/noise suppression/gain, to remove
# LattePanda fan rumble (measured 29/88/193 Hz). Default 200; 0 disables.
# BAYMAX_FAN_FILTER_HZ=200

# Additional correlated residual-echo subtraction (default on with audio enhancement).
# BAYMAX_RESIDUAL_ECHO_ENABLED=0

# Speaker stream: frames per speaker callback (64-4096, default 1024) and PortAudio's output
# latency (low, high or seconds up to 0.5; unset: sounddevice's default, high). With Ember on
# the fast cores (Orange Pi 5 / 5 Max) the default is 512 and low: measured on the 5 Max, 42 ms
# of output latency instead of about 96, with no underflows. Set them here to change that,
# e.g. 1024 and high for the stream as it was. Lower values can underrun (crackle) on a busy
# board; larger ones than allowed would break echo cancellation, so they fall back.
# BAYMAX_OUTPUT_BLOCKSIZE=512
# BAYMAX_OUTPUT_LATENCY=low

# X eyes ("unplug and replug") after Gemini is unreachable this many seconds (0 disables).
# BAYMAX_EYES_DEAD_AFTER_S=120
# Dimmed sleep eyes after this many seconds without conversation (0 disables).
# BAYMAX_EYES_SLEEP_AFTER_S=180
# X eyes when mic/speaker (5s) or camera (10s) stop reporting while connected. 0 disables.
# BAYMAX_EYES_SENSOR_WATCHDOG=1

# Eye-expression tool runs non-blocking with a SILENT result so Gemini does not speak
# its reply twice. Set 0 to restore the blocking tool (e.g. if a model rejects it).
# BAYMAX_EYE_TOOL_SILENT=1

# Post-session voice biomarker analysis at shutdown. MVP defaults to 0 so restarts
# take seconds; set 1 to analyse each session (slow on long sessions).
# BAYMAX_VOICE_ANALYSIS=0

# Opt-in robot updates before each start (see devops/mvp/README.md): follow a branch,
# run offline checks before switching, roll back if Ember never reaches listening.
# BAYMAX_AUTO_UPDATE=1
# BAYMAX_UPDATE_BRANCH=release

# Gemini prebuilt voice (default Autonoe; e.g. Fenrir, Sulafat, Puck, Kore). Unknown names are ignored.
# BAYMAX_VOICE=Autonoe

# "Ember disengage" stops Ember hearing anything but "Ember engage" (offline Vosk). 0 disables.
# BAYMAX_ENGAGE_WORDS=1

# "Look closely": on request, send Gemini one sharper (full-size, quality 90) photo
# of the current camera view to read or identify something. 0 disables.
# BAYMAX_LOOK_CLOSELY=1

# Live radio (Radio Browser) and openly licensed Internet Archive recordings (0 disables).
# BAYMAX_LISTEN_ENABLED=1
# Pause radio/recordings after this many minutes to ask whether to keep listening (0 = never).
# BAYMAX_LISTEN_CHECK_MIN=30

# Audiobook, radio and recording loudness relative to the recording (0-1, default 1 = full).
# BAYMAX_BOOK_VOLUME=1

# How loud Ember speaks, 1-10 (7 = original loudness). Only until someone changes it by
# asking ("Ember, speak louder"): that choice is saved in voice_volume.json and wins.
# BAYMAX_VOICE_VOLUME=7
# Offer the "speak louder / softer" voice control to Gemini (0 stops offering it).
# BAYMAX_VOICE_VOLUME_TOOL=1

# Ember speaks first: a hello at startup and a greeting on new eye contact (0 disables each).
# BAYMAX_STARTUP_GREETING=1
# BAYMAX_PRESENCE_GREETING=0  (eye-contact greetings; off by default, heavy on the robot CPU)
# BAYMAX_PRESENCE_QUIET_S=120
# BAYMAX_PRESENCE_COOLDOWN_S=600
# BAYMAX_PRESENCE_FPS=4

# Gentle daily check-ins (morning sleep, afternoon water, evening "how was your day"): once per
# window per day, only after 20 min uptime, when quiet and someone talked in the last 3 h. 0 disables.
# BAYMAX_CHECKINS=1
# BAYMAX_CHECKIN_MORNING=08:00-11:00   (0 turns a window off)
# BAYMAX_CHECKIN_AFTERNOON=14:00-16:30
# BAYMAX_CHECKIN_EVENING=18:00-20:30

# LED eye expressions are picked locally from the conversation; 1 gives Gemini the
# set_eye_expression tool instead (it sometimes made Gemini repeat a whole reply).
# BAYMAX_EYE_TOOL=0

# Discovery tools: trivia, brain games (local, only when asked), TV shows, poems, radio stations, recipes, Wikipedia, books.
# On by default (only the requested topic is sent to each free public service).
# EMBER_DISCOVERY_ENABLED=1

# Gemini Live models, in order (comma-separated). Ember connects with the first and moves to
# the next when this API key can't use it (not found or retired; a quota close just retries),
# until it restarts. gemini-2.5-flash-native-audio-preview-12-2025 shuts down as early as 2026-11-17;
# gemini-3.8-live needs Live quota on the key's project. Put 3.8 first once it has quota and
# `python evals/live_eval.py --model gemini-3.8-live` passes (see MVP.md, Gemini model).
# BAYMAX_LIVE_MODELS=gemini-2.5-flash-native-audio-preview-12-2025,gemini-3.8-live

# Long conversations: trim old context and resume after Gemini's ~10 min connection resets.
# BAYMAX_CONTEXT_COMPRESSION=1
# BAYMAX_CONTEXT_TRIGGER_TOKENS=32000
# BAYMAX_SESSION_RESUMPTION=1

# Local English fall check-in with Vosk + espeak-ng (v10; requires enabled fall detection).
# Prepare while online: python -m features.toolkits.offline_fall --prepare
# No device capture: python -m features.toolkits.offline_fall --check
# 0 restores Gemini-only check-ins; missing local dependencies are reported unavailable.
# Both experiments are OFF by default; the owner opts in to each separately.
# BAYMAX_OFFLINE_FALL_CHECKIN_ENABLED=0
# BAYMAX_LANGUAGE_ADAPTATION_ENABLED=0
